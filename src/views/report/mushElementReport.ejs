<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8">
    <title>Report PDF</title>
      <link rel="stylesheet" href="../dist/css/report.css">
     <!-- <script src="file://<%= data.publicPath %>plugins/chart.js/Chart.js"></script> -->
     <script src="https://cdn.jsdelivr.net/npm/chart.js@4.5.1/dist/chart.umd.min.js"></script> 

      <style>
        body { font-family: Helvetica, sans-serif; font-size:13px }
        .nuova-pagina {
          page-break-before: always; /* Per compatibilità con librerie meno recenti */
          break-before: page;        /* Standard CSS moderno */
        }
        /* h1 { color: #007bff; } */
        table { border-collapse: collapse; width: 100%;  }
        td, th { border: 1px solid #ccc; padding: 8px; text-align: left;border-collapse: collapse; }
        th { background-color: #f0f0f0;border-collapse: collapse; }
        /* Layout base specifico per la tabella Raccolti */
        table#tableBody {
            width: 100%;
            border-collapse: collapse;
            margin: 20px 0;
            font-family: Arial, sans-serif;
            font-size: 12px;
        }

        /* Stile delle celle specifico */
        table#tableBody th, 
        table#tableBody td {
            border: 1px solid #d3d3d3;
            padding: 8px 10px;
            text-align: left;
        }

        /* TH evidenziata in grigio scuro con testo bianco */
        table#tableBody th {
            background-color: #6c757d !important;
            color: #ffffff;
            font-weight: bold;
            text-transform: uppercase;
        }

        /* Effetto Zebra specifico per le righe pari di questa tabella */
        table#tableBody tr:nth-child(even) {
            background-color: #f8f9fa;
        }

      /* 📄 OTTIMIZZAZIONI SPECIFICHE PER PDF */
      @media print {
          table#tableBody tr {
              page-break-inside: avoid;
          }
          table#tableBody thead {
              display: table-header-group;
          }
      }
      .warp{
        max-width:100vw;
      }
     .container{
      line-height: 12px;
      float:left;
      width: 100%;
      }
      .elem{
        margin:2px 8px;
        padding:3px;
        width:150px;
        text-align:left;
        line-height: 18px;
        float:left;
      }
      .titleArea{
        margin-top:3mm;
        padding-top:3mm;
        border-top: thin solid #6c757d;
        width: 100%;
      }
      .elemParam{
      margin:2px 8px;
      padding:3px;
      width:90px;
      text-align:left;
      float:left;
      line-height: 18px;
      }
      h2{
        margin:0;
      }
      h4{
        margin:2px
      }
      .area {width: 100% !important;}
      </style>
  </head>
    <% 
  function formattaDataEJS(dateString) {
      if (!dateString) return '';
      const date = new Date(dateString);
      const day = String(date.getDate()).padStart(2, '0');
      const month = String(date.getMonth() + 1).padStart(2, '0');
      const year = String(date.getFullYear()).slice(-2);
      return `${day}-${month}-${year}`;
  }
  %>
  <body>
  <div>
    
    <table>
      <tr>
        <td style="width: 7cm;">
          <h2><%= data.mushElement.element_code%></h2>
        </td>
        <td style="width: 4cm;">
          Tipo di elemento: <br><%= data.mushElement.type%>
        </td>
        <td style="width: 4cm;">
          Aggiornato il <br><%= data.mushElement.updatedAt %>
        </td>
      </tr>
    </table>
    <div style="display: block; height: 5mm;">
    </div>
    <div class="area">
      <h3>Dati elemento:</h3>
      <div class="warp">
        <div class="container" style="width:100%">
            <div class="elem">
              <b>Codice:</b><br><%= data.mushElement.element_code%>
            </div>
            <div class="elem" >
              <b>Descrizione:</b><br><%= data.parentElement.parent_name%> 
            </div>
            <div class="elem" >
              <b>Stage:</b><br><%= data.mushElement.stageDesc%> 
            </div>
        </div>
        
        <div class="container" style="width:100%">
            <div class="elem" >
              <b>Magazzino:</b><br> <%= data.mushElement.storage.name_storage %> 
            </div>
            <div class="elem" >
              <b>Stato:</b><br><%= data.mushElement.stato%> 
            </div>
            <% if (data.mushElement.active==0){%>
            <div class="elem" >
              <b>Motivo prelievo:</b><br> <%= data.mushElement.pickReasonDesc %> 
            </div>
            <div class="elem" >
              <b>Data prelievo:</b><br> <%= data.mushElement.pick_date %> 
            </div>
        <% } %>
        </div>
        <div class="container" style="width:100%">
            <div class="elem" >
              <b>Contenitore:</b><br> <%= data.mushElement.contenitore_info %> 
            </div>
            <div class="elem" >
              <b>Acquistato:</b><br><%= data.parentElement.purchased? 'Si' : 'No'%> 
            </div>
            <% if (data.parentElement.purchased==1){%>
            <div class="elem" >
              <b>Data acquisto:</b><br><%= data.parentElement.purchased_date%> 
            </div>
            <% } %>
            
        </div>
        <div class="container" style="width:100%">
          <div class="elem" style="width:110px !important">
            <b>Data inizio:</b><br><%= data.mushElement.load_date%>
          </div>
          <div class="elem" style="width:110px !important">
            <b>Mat. prevista:</b><br><%= data.mushElement.expected_maturation_date%>
          </div>
          <div class="elem" style="width:110px !important">
            <b>Mat. effettiva:</b><br><%= data.mushElement.real_maturation_date%> 
          </div>
          <div class="elem" style="width:110px !important">
            <b>Frut. prevista:</b><br><%= data.mushElement.expected_fructification_date%> 
          </div>
          <div class="elem" style="width:110px !important">
            <b>Frut. effettiva:</b><br><%= data.mushElement.real_fructification_date%> 
          </div>
        </div>
      </div>
    </div>
    
    <!-- Raccolto -->
    <% if (data.areaView.raccolti==true){%>
    <div class="area">
      
      <h3 class="container titleArea">Raccolti</h3>  
      <div class="container">
        <% if (data.mushElement.mushElementHarvests.length>0){%>
          <table class="tableBody">
          <thead>
            <tr>
              <th>Data</th>
              <th>Raccolto</th>
              <th>Nota</th>
            </tr>
          </thead>
          <tbody>
             <% data.mushElement.mushElementHarvests.forEach (el => {%>
            <tr>
              <td><%= formattaDataEJS(el.harvest_date)%></td>
              <td><%= el.harvest_weight%> gr</td>
              <td><%= el.note%> gr</td>
            </tr>
            <% }) %>
          </tbody>
        </table>
        <div class="container">
          <div style="width: 100%; width: 600px; margin: 0 auto; display: block;">
              <canvas id="harvestChart"></canvas>
          </div>
      </div>
        <% } else { %>
          <div class="container alert"> Non ci sono raccolti </div>
        <% } %>
      </div>
    </div>
    <% } %>
    <!-- note -->
    <% if (data.areaView.note==true){%>
      <!-- <%# if (data.areaView.raccolti==true){%>
      <div class="nuova-pagina"></div>
      <%# } %> -->
    <div class="area">
      <h3 class="container titleArea">Note</h3> 
      <% if (data.mushElement.notes.length>0){%>
      <div class="container">
        <table class="tableBody">
          <thead>
            <tr>
              <th>Data</th>
              <th>Raccolto</th>
              <th>Nota</th>
            </tr>
          </thead>
          <tbody>
             <% data.mushElement.notes.forEach (el => {%>
            <tr>
              <td><img src="<%= el.pict%>" alt=""></td>
              <td><%= formattaDataEJS(el.check_date)%></td>
              <td><%= el.note%></td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <% } else { %>
          <div class="container alert" style="border-top: thin solid #6c757d;padding-top: 5px;"> Non ci sono note </div>
        <% } %>
    </div>
    <% } %>

    <% if (data.areaView.movimentation==true){%> 
    <!-- datiLotto -->
    <div class="area" style="width: 100%;">
      <h3 class="container titleArea">Movimentazioni</h3>
      <% if (data.storageStory.length>0){%>
      <div class="container">
        <table class="tableBody">
          <thead>
            <tr>
              <th>Magazzino</th>
              <th>Dal</th>
              <th>Al</th>
            </tr>
          </thead>
          <tbody>
             <% data.storageStory.forEach (el => {%>
            <tr>
              <td><%= el.storage%></td>
              <td><%= el.from%></td>
              <td><%= el.to%></td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <% } else { %>
          <div class="container alert" style="border-top: thin solid #6c757d;padding-top: 5px;"> Non ci sono movimentazioni </div>
        <% } %>
    </div>
    <% } %>

    <% if (data.areaView.datiLotto==true){%>
    <!-- datiLotto -->
     <div class="area" style="width: 100%; ">
      <h3 class="container titleArea">Dati lotto:</h3>
      <div class="warp">
      <div class="container">
        <div class="elem">
          <b>Descrizione:</b><br><%= data.parentElement.parent_name%>
        </div>
        <div class="elem">
          <b>Codice lotto:</b><br><%= data.parentElement.code_parent%>
        </div>
        <div class="elem">
          <b>Strain:</b><br><%= data.parentElement.strain.strain_name%>
        </div>
        <div class="elem">
          <b>Specie:</b><br><%= data.parentElement.strain.species%>
        </div>
      </div>
      <div class="container">
        <div class="elem">
          <b>Acquistato:</b><br><%= data.parentElement.purchased ? 'Si' : 'No'%>
        </div>
        <div class="elem">
          <b>Acquistato da:</b><br>
          <% if (data.parentElement.supplier){%>
          <%= data.parentElement.supplier.supplier_name%>
          <% } else { %>
            -
          <% } %>
        </div>
        <div class="elem" style="margin-right: 3cm;">
          <b>Acquistato il:</b><br>
          <% if (data.parentElement.purchased_date){%>
          <%= data.parentElement.purchased_date%>
          <% } else { %>
            -
          <% } %>
        </div>
      </div>
      <div class="container">
        <div class="elem">
          <b>Contenitore</b><br><%= data.parentElement.container.container_name%>
        </div>
        <div class="elem">
          <b>N. contenitori</b><br><%= data.parentElement.n_container%>
        </div>
      <div class="elem">
          <b>Substrato</b><br><%= data.parentElement.substrate.name_substrate%>
        </div>
      </div>
      <div class="container">
        <div class="elem">
          <b>Qt substrato <%= data.parentElement.container.uom %></b><br><%= data.parentElement.substrateQt%>
        </div>
        <div class="elem">
          <b>% di Inoculo</b><br><%= data.parentElement.strainPerc%>
        </div>
        <div class="elem">
          <b>Qt inoculo <%= data.parentElement.container.uom %></b><br><%= data.parentElement.strainWeight%>
        </div>
      </div>
      <div class="container">
        <div class="elem">
          <b>Magazzino</b><br><%= data.mushElement.storage.storage_code%> - <%= data.mushElement.storage.name_storage%>
        </div>
        <div class="elem">
          <b>Scadenza lotto</b><br><%= data.parentElement.exp_date%>
        </div>
      <div class="elem" style="width: 6cm;">
          <b>Prevista maturazione</b><br><%= data.parentElement.expected_maturation_date%>
        </div>
      </div>
      <div class="container" style="width: 100%;margin-top: 2mm;">
      <% if (data.seeds.length>0){%>
      <div class="container" style="width: 100%; margin-bottom:0px; margin-bottom: 1mm;">
        <h4>Seeds</h4>
        <ul>
          <% data.seeds.forEach (el => {%>
          <li>
            <%= el.mushElementCode%> - <%= el.perc%> %
          </li>
          <% }) %>
        </ul>
      </div>
      <% } %>
      </div>
      </div>
      </div>
    <% } %>
    <% if (data.areaView.strain==true){%>
    
    <!-- datiStrain -->
     <div class="area" style="width: 100%;   ">
      <h3 class="container titleArea">Dati strain:</h3>
        <div class="container">
          <div class="elem" >
            <b>Codice:</b><br><%= data.parentElement.strain.code_strain%>
          </div>
          <div class="elem">
            <b>Nome:</b><br><%= data.parentElement.strain.strain_name%>
          </div>
          <div class="elem" style="width:300px !important; ">
            <b>Descrizione:</b><br><%= data.parentElement.strain.description%>
          </div>
          
        </div>
        <div class="container" style="width: 100%;">
          <div class="elem">
            <b>Specie:</b><br><%= data.parentElement.strain.species%>
          </div>
          <div class="elem">
            <b>Codice specie:</b><br><%= data.parentElement.strain.species_code%>
          </div>
          <div class="elem">
            <b>Fornitore:</b><br><%= data.parentElement.supplierId%>
          </div>
          <div class="elem">
            <b>Acquistato il:</b><br><%= data.parentElement.buyed%>
          </div>
          
        </div>
        <div class="container" style="width: 100%;"> 
          <div class="elem" >
            <b>Substrato consigliato:</b><br><%= data.parentElement.strain.liked_substrate%>
          </div> 
          

          <div class="elem" style="width: 100% !important;">
            <b>Note:</b><br><%= data.parentElement.strain.note%>
          </div>
        
        </div>
        <div class="container" style="width: 100%;">
          <div class="elem" style="width: 90% !important; ">
            <table class="tableBody">
              <thead>
                <tr>
                <th></th>
                <th>Incubazione</th>
                <th>Primordia</th>
                <th>Fruttificazione</th>
              </tr>
              </thead>
              <tbody>
                <tr>
                  <th>Temperatura C°</th>
                  <td><%= data.parentElement.strain.incubation_temp%></td>
                  <td><%= data.parentElement.strain.primordia_temp%></td>
                  <td><%= data.parentElement.strain.fructification_temp%></td>
                </tr>
                <tr>
                  <th>Umidità %</th>
                  <td><%= data.parentElement.strain.incubation_hum%></td>
                  <td><%= data.parentElement.strain.primordia_hum%></td>
                  <td><%= data.parentElement.strain.fructification_hum%></td>
                </tr>
                <tr>
                  <th>Durata (giorni)</th>
                  <td><%= data.parentElement.strain.incubation_len%></td>
                  <td><%= data.parentElement.strain.primordia_len%></td>
                  <td><%= data.parentElement.strain.fructification_len%></td>
                </tr>
                <tr>
                  <th>Co2 ppm</th>
                  <td><%= data.parentElement.strain.incubation_co2%></td>
                  <td><%= data.parentElement.strain.primordia_co2%></td>
                  <td><%= data.parentElement.strain.fructification_co2%></td>
                </tr>
                <tr>
                  <th>Estrazione ciclo/ora</th>
                  <td><%= data.parentElement.strain.incubation_airExch%></td>
                  <td><%= data.parentElement.strain.primordia_airExch%></td>
                  <td><%= data.parentElement.strain.fructification_airExch%></td>
                </tr>
                <tr>
                  <th>Luce lux</th>
                  <td><%= data.parentElement.strain.incubation_light%></td>
                  <td><%= data.parentElement.strain.primordia_light%></td>
                  <td><%= data.parentElement.strain.fructification_light%></td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    <% } %>
  </div>



<!-- 3. Configura lo script per generare il grafico -->
<script>
    // PASSO FONDAMENTALE: Passa il dataset da EJS a JavaScript del browser
   const rawData = <%- JSON.stringify(data.mushElement.mushElementHarvests || []) %>;

    // Funzione di utilità per formattare le date in dd-mm-yy direttamente nel browser
    function formatDate(dateString) {
        const date = new Date(dateString);
        const day = String(date.getDate()).padStart(2, '0');
        const month = String(date.getMonth() + 1).padStart(2, '0');
        const year = String(date.getFullYear()).slice(-2);
        return `${day}-${month}-${year}`;
    }

    // Mappiamo i dati per estrarre le etichette (X) e i valori (Y)
    // Sostituisci 'harvest_date' e 'harvest_weight' con i nomi reali dei tuoi campi
    const labels = rawData.map(item => formatDate(item.harvest_date));
    const weights = rawData.map(item => item.harvest_weight);

    // Inizializzazione di Chart.js
    const ctx = document.getElementById('harvestChart').getContext('2d');
    new Chart(ctx, {
        type: 'bar', // Tipo di grafico: 'bar', 'line', 'pie', ecc.
        data: {
            labels: labels, // Asse X (Date formattate)
            datasets: [{
                label: 'Peso Raccolto (g)',
                data: weights, // Asse Y (Pesi)
                backgroundColor: 'rgba(54, 162, 235, 0.5)',
                borderColor: 'rgba(54, 162, 235, 1)',
                borderWidth: 1
            }]
        },
        options: {
            responsive: true,
            scales: {
                y: {
                    beginAtZero: true
                }
            }
        }
    });
</script>

  </body>
</html>