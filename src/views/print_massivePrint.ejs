<%- include ('header') %>
<%- include ('navbar') %>
<%- include ('sidebar') %>

  <div class="content-wrapper">
    <!-- Content Header (Page header) -->
    <div class="content-header">
      <div class="storage-fluid">
        <div class="row mb-2">
          <div class="col-sm-6">
            <h1 class="m-0">CSVS stampa massiva etichette lotti</h1>
          </div>
          
        </div>
      </div>
    </div>

    <!-- Main content -->
    <section class="content">
      <div class="container-fluid">
        <div class="row">
          
            <div class="col-12"  id="tableStorage_Crd" style="">
                <div class="card">
                  <div class="card-header">
                    <h3 class="card-title">Seleziona  stampa  </h3>
                  </div>
                  
                  <div class="card-body ">
                    <div class="row ">
                      <form class="form-inline w-100" id="searchElement_Frm">
                        <div class="row align-items-center w-75">
                          <div class="col-12 col-md-3 my-2">
                            <label class="sr-only" for="textareaData">Data</label>
                            <input type="text" class="form-control form-control-sm w-100" id="intervalData" name="intervalData" value="" style="width: 200px;">
                          </div>

                          <div class="col-6 col-md-2 my-2">
                            <div class="form-check">
                              <input class="form-check-input" type="checkbox" id="checkInoculi" checked>
                              <label class="form-check-label small" for="checkInoculi">
                                Inoculi
                              </label>
                            </div>
                          </div>
                          <div class="col-6 col-md-2 my-2">
                            <div class="form-check">
                              <input class="form-check-input" type="checkbox" id="checkSpawn" checked>
                              <label class="form-check-label small" for="checkSpawn">
                                Spawn
                              </label>
                            </div>
                          </div>

                          <div class="col-6 col-md-2 my-2">
                            <div class="form-check">
                              <input class="form-check-input" type="checkbox" id="checkPropagation" checked>
                              <label class="form-check-label small" for="checkPropagation">
                                Propagazioni
                              </label>
                            </div>
                          </div>

                      <button type="button" class="btn btn-primary btn-sm" id="searchElement_Btn"> Cerca elementi</button>
                          
                        </div>
                      </form>
                     
                      
                    </div>
                    <div class="row mt-2" id="elementList_Wrp">
                      <form id="elementList_Frm" class="w-100">

                      </form>
                     <button type="button" class="btn btn-xs btn-primary" id="createCsv" style="display: none;"> <i class="fas fa-file-csv    "></i> Crea CSV</button>

                    </div>
                  </div>
                </div>
              </div>
            
        </div>
        
      </div>
    </section>
    
  </div>
  
 
  
  <%- include ('footer') %>
  <%- include ('jsLoad') %>
  <script>
    let fromDate,toDate

    async function  drawList (fromDate="",toDate=""){
      let inoculi_CHK=$("#checkInoculi").is(":checked")?1:0
      let spawn_CHK=$("#checkSpawn").is(":checked")?1:0
      let propagation_CHK=$("#checkPropagation").is(":checked")?1:0
   await $.ajax({
        type: "GET",
        url: "/print/getElementToPrint?fromDate="+fromDate+"&toDate="+toDate+"&inoculi_CHK="+inoculi_CHK+"&spawn_CHK="+spawn_CHK+"&propagation_CHK="+propagation_CHK,
        success: async function (response) {
            console.log(response)
            fromDate=response.fromDate
            toDate=response.toDate
            let html=""
            // Inoculi
            if(response.result.inoculum.length>0){
              html+="<div class=\"h4\">Inoculi<div>"
            for (let i = 0; i < response.result.inoculum.length; i++) {
                const elem=response.result.inoculum[i]
                html+=`<div class="row w-100 p-2 m-1 border-bottom" id="section_${elem.code_inoculum}">
                        <div class="col-12 h5 selectChild" >
                        <a  code="${elem.code_inoculum}" class="selectChild">${elem.inoculum_name}</a>
                        </div>`
                        for (let y = 0; y < elem.mushElements.length; y++) {
                          const el = elem.mushElements[y];
                      html+=`<div class="col-2">
                          <div class="form-check">
                                  <label class="form-check-label small" style="font-size:1rem">
                                    <input type="checkbox" class="form-check-input ${elem.code_inoculum}" name="elementCode" id="${el.element_code}" value="${el.element_code}" >
                                  ${el.element_code}
                                  </label>
                                </div>
                                </div>`
                        }
                  html+="</div>"  
                } $("#createCsv").show()
                 } 
            // Spawn
            if(response.result.spawn.length>0){
              html+="<div class=\"h4\">Spawn<div>"
            for (let i = 0; i < response.result.spawn.length; i++) {
                const elem=response.result.spawn[i]
                html+=`<div class="row w-100 p-2 m-1 border-bottom" id="section_${elem.code_spawn}">
                        <div class="col-12 h5 selectChild" >
                        <a  code="${elem.code_spawn}" class="selectChild">${elem.spawn_name}</a>
                        </div>`
                        for (let y = 0; y < elem.mushElements.length; y++) {
                          const el = elem.mushElements[y];
                      html+=`<div class="col-2">
                          <div class="form-check">
                                  <label class="form-check-label small" style="font-size:1rem">
                                    <input type="checkbox" class="form-check-input ${elem.code_spawn}" name="elementCode" id="${el.element_code}" value="${el.element_code}" >
                                  ${el.element_code}
                                  </label>
                                </div>
                                </div>`
                        }
                  html+="</div>"  
                } 
                $("#createCsv").show()
                 } 
            // Propagation
            if(response.result.propagation.length>0){
              html+="<div class=\"h4\">Propagazioni<div>"
            for (let i = 0; i < response.result.propagation.length; i++) {
                const elem=response.result.propagation[i]
                html+=`<div class="row w-100 p-2 m-1 border-bottom" id="section_${elem.code_propagation}">
                        <div class="col-12 h5 selectChild" id="section_${elem.code_propagation}">
                        <a  code="${elem.code_propagation}" class="selectChild">${elem.propagation_name}</a>
                        </div>`
                        for (let y = 0; y < elem.mushElements.length; y++) {
                          const el = elem.mushElements[y];
                      html+=`<div class="col-2">
                          <div class="form-check">
                                  <label class="form-check-label small" style="font-size:1rem">
                                    <input type="checkbox" class="form-check-input ${elem.code_propagation}" name="elementCode" id="${el.element_code}" value="${el.element_code}" >
                                  ${el.element_code}
                                  </label>
                                </div>
                                </div>`
                        }
                  html+="</div>"  
                } 
                $("#createCsv").show()
                 } 
            
           if(response.result.inoculum.length==0 && response.result.spawn.length==0 && response.result.propagation.length==0){
              html+=`<div class="alert alert-danger" role="alert"">Non ci sono dati disponibili, prova a cambiare i filtri<div>`
                $("#createCsv").hide()
              }
            $("#elementList_Frm").html(html)
            
                let picker = $('#intervalData').data('daterangepicker');
                if (picker) {
                    // Se il daterangepicker esiste già, aggiorna solo le date senza romperlo
                    picker.setStartDate(moment(response.fromDate).format("DD/MM"));
                    picker.setEndDate(moment(response.toDate).format("DD/MM"));
                } else {
                    // Se è la primissima volta in assoluto che carichi la pagina, lo inizializzi
                    $('#intervalData').daterangepicker({
                      autoApply: true,
                        startDate: moment(response.fromDate).format("DD/MM"),
                        endDate: moment(response.toDate).format("DD/MM"),
                        locale: {
                            format: 'DD/MM'
                        }
                  });
                } 
            }
    });
}
  

    $(document).ready(async function () {
      await drawList()

      $("#searchElement_Btn").click(async function (e) { 
        let drp = $('#intervalData').data('daterangepicker');
        fromDate = drp.startDate.format('YYYY-MM-DD');
        toDate = drp.endDate.format('YYYY-MM-DD');
        await drawList(fromDate,toDate)
      });
      
      $(document).on("click",".selectChild", async function (e) { 
        e.preventDefault();
        let code=$(this).attr("code")
        if(code!=undefined){
                console.log(code)
                console.log("---")
                $("."+code).prop("checked", true)}
        //section_
      });



      $("#createCsv").click(async function (e) { 
        e.preventDefault();
        await drawList()
      })
      

      $("#createCsv").click(function (e) { 
        e.preventDefault();
        let elementArr=[]
        $("#elementList_Frm").serializeArray().forEach(element => {
            elementArr.push(element.value)
        });
        console.log(elementArr)
         let url="/print/massivePrintCSV?elementCode="+elementArr
      window.open(url, '_blank').focus();
        // $.ajax({
        //   type: "POST",
        //   url: "/print/massivePrint",
        //   data: $("#elementList_Frm").serializeArray(),
        //   success: function (response) {
        //     console.log(response)
        //   }
        // });
      });
   
     });

  </script>
  <%- include ('closeTag') %>
  