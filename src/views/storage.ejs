<%- include ('footer') %>
  <%- include ('jsLoad') %>
  <script>
    

    let storages 
    let redirectId= <%- JSON.stringify( redirectId) %>
    let idStorage=redirectId
    

    async function drawTable (){
      await $.ajax({
        type: "GET",
        url: "/storage/getAll",
        success: async function (response) {
          console.log(response)
          storages=response.storages
          let html
          if (storages.length>0){
            storages.forEach(el=>{
              html+=`<tr>
                <td style="width: 80px;">
                      <button type="button" name="" id="showBtn_${el.id}" 
                        class="btn btn-primary btn-xs showStorage" style="width:25px">
                          <i class="fa fa-eye fa-sm" aria-hidden="true"></i>
                      </button>
                      <button type="button" name="" idStorage="${el.id}" 
                        class="btn btn-danger btn-xs deleteStorage" style="width:25px">
                          <i class="fa fa-minus fa-sm" aria-hidden="true"></i>
                      </button>
                  </td>
                  <td >${el.id}</td>
                  <td>${el.code_storage}</td>
                  <td>${el.area_HomeAssistant}</td>
                  <td>${el.name_storage}</td>
                  <td>${el.data_storage}</td>
                </tr>`
  
            })
            $("#storage_TBLB").html(html);
            $("#storage_TBL").show();
            $("#storage_ALT").hide();

          }
          else{
            $("#storage_TBL").hide();
            $("#storage_ALT").show();
          }
          $("#tableStorage_Crd").show();
          $("#newStorage_Crd").hide();
          }
        })
    }

    function drawShowStorage(id) {
   $.ajax({
        type: "GET",
        url: "/storage/getOneStorage?storageId="+id,
        success: async function (response) {
          console.log(response)
          let data=response.storage
          
            // Populate GUI
            for (const [key, value] of Object.entries(data)) {
              if($("#"+key+"_Fld").attr("tp")=="textField"){
                $("#"+key+"_Fld").val(value)
              }
              if($("#"+key+"_Fld").attr("tp")=="selectField"){
                $("#"+key+"_Fld").val(value).change();
              }
              console.log(key,data[key])
              switch (key) {
              case "indoor":
                  $("#"+key+"_Show").html((value===1)?"Sì":"No")
                break;
              case "rawmaterial":
                  $("#"+key+"_Show").html((value===1)?"Sì":"No")
                break;
              case "container":
                  $("#"+key+"_Show").html((value===1)?"Sì":"No")
                break;
              case "inoculum":
                  $("#"+key+"_Show").html((value===1)?"Sì":"No")
                break;
              case "spawn":
                  $("#"+key+"_Show").html((value===1)?"Sì":"No")
                break;
              case "propagation":
                  $("#"+key+"_Show").html((value===1)?"Sì":"No")
                break;
              default:
                $("#"+key+"_Show").html(value?value:"-")
                break;
              }
            }
            let html=""
            $(".storageForm").hide()
            $(".storageText").show()
            $("#tableStorage_Crd").hide();
            $("#newStorage_Crd").show();
            $("#newStorage_Btn").hide();
            $("#backToMain_Btn").show();
        }
      });   
}    
  

    $(document).ready(async function () {
      if (redirectId!=null){
        drawShowStorage(redirectId)
      } else {
        await drawTable()  
      }


      $(document).on("click",".showStorage", function (e) { 
        e.preventDefault();
        let id=$(this).attr("id").split("_")[1]
        window.location="/storage?redirectId="+id
      });

      $("#newStorage_Btn").click(function (e) { 
        e.preventDefault();
        $("#tableStorage_Crd").hide();
        $("#newStorage_Btn").hide();
        $("#newStorage_Crd").show();
        $("#saveNewStorage_Btn").show();
        $("#abortStorage_Btn").show();
      });

      $("#abortStorage_Btn").click(function (e) { 
        e.preventDefault();
        resetForm("storage_FRM")
        $("#tableStorage_Crd").show();
        $("#newStorage_Btn").hide();
        $("#newStorage_Btn").show();

        $("#newStorage_Crd").hide();
        $("#saveNewStorage_Btn").hide();
        $("#abortStorage_Btn").hide();
      });
      
      $("#saveNewStorage_Btn").click(function (e) { 
        e.preventDefault();
        let formArr=$("#storage_FRM").serializeArray()
        let checkItem=false
        formArr.forEach(elem=>{
          if ((elem.name=="rawmaterial")||(elem.name=="inoculum")||(elem.name=="spawn")||(elem.name=="propagation")||(elem.name=="container")){
            checkItem=true
          }
        })
        if (checkItem==false){
            alert("Seleziona una tipologia di materiale contenuto nello storage")
            return
        }
        if (checkForm("storage_FRM")){
          if (confirm("Stai inserendo un nuovo storage, continuare?")){
            $.ajax({
              type: "POST",
              url: "/storage/newStorage",
              data: $("#storage_FRM").serialize(),
              success: function (response) {
                window.location="/storage/"
              }
            });
          }
        }
      });
    

      $(document).on("click",".deleteStorage", function () {
        let idStorage=$(this).attr("idStorage")
        let c=confirm("Stai eleiminando uno storage e con esso tutti gli attuatori, gli allarmi e i sensori colegati, vuoi continuare? (l'eliminazione non elimina i sensori e i dati registati)")
        if(c){
        $.ajax({
          type: "delete",
          url: "/storage/deleteStorage?idStorage="+idStorage,
          success: function (response) {
            window.location="/storage"
          }
        });}
      });

      // Back to main
    $("#backToMain_Btn").click(function (e) { 
          e.preventDefault();
          window.location='/storage'
        });
    });


  </script>
