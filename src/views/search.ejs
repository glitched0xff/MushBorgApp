<%- include ('header') %>
<%- include ('navbar') %>
<%- include ('sidebar') %>

  <div class="content-wrapper">
    
    <section class="content">
        <div class="container-fluid">
            <h2 class="text-center display-4">Search</h2>
            <div class="row">
                <div class="col-md-8 offset-md-2 mt-2">
                    <form>
                        <div class="input-group">
                            <input type="search" class="form-control form-control-lg " id="search_FieldPage">
                            <div class="input-group-append">
                                <button type="submit" class="btn btn-lg btn-default " id="search_BtnPage">
                                    <i class="fa fa-search"></i>
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
              <div class="row w-100 mt-2" >
                <div class="card w-100" >
              <div class="card-body">
                
                <div class="table-responsive pb-3">
                  <div class="col w-100 text-center small">
                    Elementi trovati: <span id="elNum_Span"></span>
                  </div>
                  <table class="display table table-striped table-bordered compact" id="result_Tbl" style="width: 100%; display: none">
                  <thead>
                      <tr>
                        <th style="width:20%"></th>
                        <th style="width:40%">Codice</th>
                        <th style="width:40%">Nome</th>
                      </tr>
                  </thead>
                  <tbody id="result_Tblb">
                    
                  </tbody>
                  </table>
                  </div>
              </div>
                </div>
              </div>
    </section>
    
  </div>

  <%- include ('jsLoad') %>
    
<script>
  let searchedString= "<%= searchedString %>"
  let tableSearch
  let requestCode
  
  function drawResult(requestCode){
    let total=0
    let html=""
    $.ajax({
      type: "GET",
      url: "/search/search?requestCode="+requestCode,
      success: function (response) {
      console.log(response)
      tableSearch.clear();
      data=response.result
      data.forEach(elem => {   
            let html
            switch (elem.typeSearch) {
              case "mushElement":
                html=`<tr>
                      <td><span class="badge badge-primary">Mush element</span></td>
                      
                      <td><a href="/mushElement/singleMushElement?id=${elem.id}&filterCategory=${elem.type}" target="_blank">${elem.element_code}<a></td>
                      <td></td>
                      <td></td>
                    </tr>
                      `
                break;
              case "propagation":
                html=`<tr>
                      <td><span class="badge badge-secondary">Propagation</span></td>
                      
                      <td><a href="/propagation?redirectId=${elem.id}" target="_blank">${elem.code_propagation} <a></td>
                      <td>${elem.propagation_name}</td>
                      <td></td>
                    </tr>`
                break;
              case "spawn":
                html=`<tr>
                      <td><span class="badge badge-success">Spawn</span></td>
                      
                      <td><a href="/spawn?redirectId=${elem.id}" target="_blank">${elem.code_spawn}<a></td>
                      <td> ${elem.spawn_name}</td>
                      <td></td>
                    </tr>`
                break;
              case "inoculum":
                html=`<tr>
                      <td><span class="badge badge-warning">Inoculum</span></td>
                      
                      <td><a href="/inculum?redirectId=${elem.id}" target="_blank">${elem.code_inoculum}<a></td>
                      <td> ${elem.inoculum_name}</td>
                      <td></td>
                    </tr>`
                  break;
              case "strain":
                html=`<tr>
                      <td><span class="badge badge-info">Strain</span></td>
                      
                      <td><a href="">${elem.strain_name}<a></td>
                      <td></td>
                      <td></td>
                    </tr>`
                
                break;
            }
            $("#elNum_Span").html(data.length);
            tableSearch.rows.add($(html));
        })
        tableSearch.draw();
        $("#result_Tbl").show();
      }
      });
   // $("#result_Div").html(`<div class="col-8 mx-auto" id="searchString_Spn">Testo cercato:${searchedString} - trovati n° :${total}</div>`)
  
  }

    $(document).ready(async function () {
      $("#searchHeader").hide()
      tableSearch = $('#result_Tbl')
                         .DataTable({
                                     paging: false,       // Disattiva la paginazione
                                    scrollY: '500px',    // Attiva lo scrolling verticale (circa 25 righe)
                                    scrollCollapse: true ,// Comprime l'altezza se ci sono meno di 25 righe
                                    //pageLength: 25,
                                    dom: 'tp',
                                    columnDefs: [{ targets: 0, width: "20%", className: 'dt-center'},  
                                                  { targets: 1, width: "40%",className: 'dt-center' }, 
                                                  { targets: 2, width: "40%",className: 'dt-center' }, 
                                                  
                                              ]
                                          });  
      $('#result_Tbl').DataTable().columns.adjust().draw();
      
      await drawResult(searchedString)
      $("#search_FieldPage").val(searchedString!="false"?searchedString:"")
      
      $("#search_FieldPage").on("input",async function (e) { 
        let ss=$(this).val();
        console.log(ss)
        if (ss.length>=2){
          await drawResult(ss)
        }
        if (ss.length==0){
          await drawResult("")
        }
      });

      $("#search_BtnPage").click(async function (e) { 
        e.preventDefault();
        searchedString=$("#search_FieldPage").val()
        console.log(searchedString)
        await drawResult(searchedString)
      });
    });


  </script>
  <%- include ('footer') %>

  <%- include ('closeTag') %>
  