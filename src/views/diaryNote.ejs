  <!-- Modal insert note -->
  <div class="modal fade" id="editDiaryNote_Mdl" tabindex="-1" role="dialog" aria-labelledby="modelTitleId" aria-hidden="true">
    <div class="modal-dialog" role="document">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="editDiaryNote_Mdl_Ttl"> Aggiungi nota</h5>
            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
              <span aria-hidden="true">&times;</span>
            </button>
        </div>
        <div class="modal-body">
          <form id="editDiaryNote_Frm">
              <%- include('include/ejsForm',
            { classTxt: "diaryNoteText",
              classField: "diaryNoteForm",
              form:[
              { 
                type:"hidden",
                fieldName:"idDiaryNote"
              },
              {
                type:"text",
                classBox:"col-md-12",
                fieldName:"dataNota",
                label:"Data",
                required:true, 
                readonly:true
              },
              {
                type:"textarea",
                classBox:"col-md-12",
                fieldName:"nota",
                label:"Nota",
                required:true, 
              },
              {
                type:"text",
                classBox:"col-md-12",
                fieldName:"tag",
                label:"Tag",
              },
              
              ]  
              }) %>
          </form>
          <div class="row w-100">
            <button class="btn btn-xs btn-primary mx-1" id="saveNewNota_Btn" style="display: none;" idElement=""> <i class="fas fa-pen"></i> Salva nota </button>
            <button class="btn btn-xs btn-primary mx-1" id="saveNota_Btn" style="display: none;" idElement=""> <i class="fas fa-pen"></i> Salva modifica </button>
            <button class="btn btn-xs btn-secondary mx-1" id="abortNota_Btn" style="display: none;" idElement=""> <i class="fas fa-pen"></i> Annulla modifica </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  
  <%- include ('footer') %>
  <%- include ('jsLoad') %>
  <script>
    // let diaryNotes = '<%# JSON.stringify(diaryNotes) %>'
    // diaryNotes=JSON.parse(diaryNotes)
    // console.log(diaryNotes)
    let fromDate
    let toDate
    function resetForm(formName){
    $("#"+formName).get(0).reset()
    $($('#'+formName).prop('elements')).each(function(){
      $(this).removeClass("border-danger")
      $(this).removeClass("border-success")
    })
}

function getMonthLetter(data){
  let month=["Gennaio","Febbraio","Marzo","Aprile","Maggio","Giugno","Luglio","Agosto","Settembre","Ottobre","Novembre","Dicembre"]
  return month[data-1]
}
  
async function drawTableNote(fromDate="",toDate=""){
  let html=""
  await $.ajax({
    type: "GET",
    url: "/diaryNote/getAll?fromDate="+fromDate+"&toDate="+toDate,
    success: function (response) {
      console.log(response)
      fromDate=response.fromDate
      toDate=response.toDate
      html+=`<div class="timeline">`
        for (let i = 0; i < response.notes.length; i++) {
          const elem = response.notes[i];
          html+=`<div class="time-label">
                            <span class="bg-red">${elem.giorno} - ${getMonthLetter(elem.mese)}</span>
                          </div>
                          <div>
                            <i class="fas fa-arrow-right bg-blue"></i>
                            <div class="timeline-item">
                              <div class="timeline-body">
                                <ul>`
          
          for (let n = 0; n < elem.note.length; n++) {
            const nt = elem.note[n];
            html+=`<li>${moment(nt.dataNota).format("HH:mm")} ${nt.nota}</li>`
          }
          html+=`</ul>
                    </div>
                    <div class="col w-100 text-right"> 
                      <a class="addNote" dataNota="${elem.note[0].dataNota}">
                        <i class="fa fa-plus-circle" aria-hidden="true"></i>
                        </a>
                      </div>
                    </div>
                          </div>`      
        }
      html+=`</div>`  
      $("#elencoNote").html(html)   
       let picker = $('#intervalData').data('daterangepicker');
                if (picker) {
                    // Se il daterangepicker esiste già, aggiorna solo le date senza romperlo
                    picker.setStartDate(moment(response.fromDate).format("DD/MM"));
                    picker.setEndDate(moment(response.toDate).format("DD/MM"));
                } else {
                    // Se è la primissima volta in assoluto che carichi la pagina, lo inizializzi
                    $('#intervalData').daterangepicker({
                        startDate: moment(response.fromDate).format("DD/MM"),
                        endDate: moment(response.toDate).format("DD/MM"),
                        locale: {
                            format: 'DD/MM' // È consigliabile usare il formato completo internamente per evitare bug
                        }
                    });} 
    }
    
  });
  
}
  
    $(document).ready(function () {

       $(function() {
        $('input[name="datetimes"]').daterangepicker({
           opens: 'left',
           locale: {
            format: 'DD-MM-YY'
          }
        });
      });

        drawTableNote()
      // Date range
      $('#daterange').on('apply.daterangepicker', async function(ev, picker) {
        ev.preventDefault();
        let fromDate=moment(picker.startDate).toISOString()
        let toDate=moment(picker.endDate).toISOString()
        await drawTableNote(fromDate,toDate)
      });
      // clear filter
      $("#clearFilter").click(async function (e) { 
        e.preventDefault();
        await drawTableNote()
      });
    
        $(document).on("click",".deleteDiaryNote",function (e) { 
          e.preventDefault();
          let idDiaryNote=$(this).attr("idDiaryNote")
          console.log(idDiaryNote)
        });
        $("#editDiaryNote_Btn").click(function (e) { 
          e.preventDefault();
          $("#dataNota_Fld").val(moment().format("DD-MM-YY hh:mm"))
          $("#editDiaryNote_Mdl").modal("show")
          $("#saveNewNota_Btn").show()
          $("#abortNota_Btn").show()
        });
        $("#saveNewNota_Btn").click(function (e) { 
          e.preventDefault();
          $.ajax({
            type: "POST",
            url: "/diaryNote/newNota",
            data: $("#editDiaryNote_Frm").serialize(),
            success: async function (response) { 
              await drawTableNote(fromDate,toDate)  
              $("#editDiaryNote_Mdl").modal("hide")
              resetForm("editDiaryNote_Frm")  
            }
          })
        });

        $("#saveNota_Btn").click(function (e) { 
          e.preventDefault();        
        });

        // aggiunge la nota ad un giorno definito
        $(document).on("click",".addNote", function () {
          let newData=$(this).attr("datanota")
          console.log(newData)
          $("#dataNota_Fld").val(moment(newData).format("DD-MM-YY hh:mm"))

          $("#editDiaryNote_Mdl").modal('show')
          $("#saveNewNota_Btn").show()
          $("#abortNota_Btn").show()
        });

        $("#abortNota_Btn").click(function (e) { 
          e.preventDefault();
          $("#editDiaryNote_Mdl").modal("hide")
          resetForm("editDiaryNote_Frm")
        });
    });

  </script>
  <%- include ('closeTag') %>
  