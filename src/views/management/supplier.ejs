<script>

 //let materialCategory = '<%# JSON.stringify(materialCategory) %>'
 //materialCategory=JSON.parse(materialCategory)
let tableSupplier
let idSupplier
// Draw Category Drop down
function drawCategoryDD(){
  let html=""
  materialCategory.forEach(el => {
    html+=`<option value="${el.id}">${el.category_name}</option>`
  });
   $('#categoryDD_Fld').html(html)
  
}
// Draw and update table
async function  drawTable (){
   await $.ajax({
        type: "GET",
        url: "/supplier/getAll",
        success: async function (response) {
          console.log(response)
            let html=""
            for (let i = 0; i < response.suppliers.length; i++) {
                let el=response.suppliers[i]
                let delBtnDisable=""
                // if (el.used!=0){
                //   delBtnDisable="disabled"
                // }
                html+=`<tr>
                           <td>
                            <button type="button" name="" id="showBtn${el.id}" 
                            class="btn btn-primary btn-xs showSupplier" style="width:25px"
                            idSupplier="${el.id}" supplierName="${el.supplier_name}">
                              <i class="fa fa-eye fa-sm" aria-hidden="true"></i>
                          </button>
                          <button type="button" name="" id="delete${el.id}" 
                          class="btn btn-danger btn-xs deleteSupplier_Btn" style="width: 25px" 
                          idSupplier="${el.id}" supplierName="${el.supplier_name }" ${delBtnDisable}>
                            <i class="fa fa-trash fa-sm " aria-hidden="true"></i>
                          </button>
                        </td>
                                <td>${el.supplier_name}</td>
                                <td>${el.phone?el.phone:"-"}</td>
                                <td>${el.mail?el.mail:"-"}</td>
                                <td>${moment(el.createdAt).format("DD-MM-YY HH:mm")}</td>
                            </tr>`
                
                }
                await $('#supplier_Tbl').DataTable().clear().rows.add($(html)).draw();
            }
    });

}

// Find element supplier
async function elementBySupplier(){
  $.ajax({
    type: "GET",
    url: "/supplier/getElementBySupplier?id="+idSupplier,
    success: function (response) {
      console.log(response)
      $("#element_TBL").html("")
      if (response.inoculum.length){
        drawElementTable("Inoculi",
                        ["","Codice ","Nome","Numero contenitori","Data di acquisto"],
                        ["code_inoculum","inoculum_name","n_container","purchased_date"],
                        response.inoculum,
                        "id",
                        "/inoculum?redirectId=")}
      if (response.spawn.length){
        drawElementTable("Spawn",
                        ["","Codice ","Nome","Numero contenitori","Data di acquisto"],
                        ["code_spawn","spawn_name","n_container","purchased_date"],
                        response.spawn,
                        "id",
                        "/spawn?redirectId=")}
      if (response.propagation.length){
        drawElementTable("Lotti coltivazioni",
                        ["","Codice ","Nome","Numero contenitori","Data di acquisto"],
                        ["code_propagation","propagation_name","n_container","purchased_date"],
                        response.propagation,
                        "id",
                        "/propagation?redirectId=")}
      if (response.rawMaterial.length){
        drawElementTable("Materiali",
                        ["","Nome materiale","Quantità","Creato il"],
                        ["material_name","quantity","createdAt"],
                        response.rawMaterial,
                        "id",
                        "/rawMaterial?redirectId=")}
    }
  });
}
function drawElementTable(title,header,field,data,indexLink,route){
const formatoISO = "YYYY-MM-DDTHH:mm:ss.SSSZ";
  let html= `
  <div class="col-12 my-2">
    <h4>${title}</h4>
  <table class="table table-sm table-striped"><thead><tr>`
  header.forEach(el => {
    html+=`<th>${el}</th>`
  });
  html+="</tr></thead><tbody>"
  data.forEach(el=>{
    html+=`<tr>`
    html+=`<td >
              <a href="${route}${el[indexLink]}" target="_blank">
              <button type="button" class="btn btn-primary btn-xs " style="width:25px">
                    <i class="fa fa-eye fa-sm" aria-hidden="true"></i>
                </button></a>
              </td>`
    field.forEach(fl=>{
      if (moment(el[fl], formatoISO, true).isValid()){
        let dt=moment(el[fl], formatoISO).format("DD-MM-YY")
        console.log(moment(el[fl], formatoISO).format("DD-MM-YY"))
        html+=`<td >${dt}</td>`
      }
      else{ html+=`<td >${el[fl]}</td>`}
    }
    )
    html+=`</tr>`
  })
  html+=` </tbody> </table></div>`
  $("#element_TBL").append(html);
}


$(document).ready(async function () {
  tableSupplier=$('#supplier_Tbl').DataTable({responsive: true,pageLength: 50});
  await drawTable()
    
    // New rawMAterial
  $("#newSupplier_Btn").click(async function (e) { 
    e.preventDefault();
    $("#supplier_FRM").trigger("reset")   
    $(".supplierForm").show()
    $(".supplierText").hide()
    $("#rowSupplier").hide() 
    $("#newSupplier_Btn").hide()
    $("#backToMain_Btn").show()
    $("#tableSupplier_Crd").hide()
    $("#showSupplier_Crd").show()
    $("#element_Row").hide()
    $("#saveNewSupplier_Btn").show()
    $("#saveModSupplier_Btn").hide()
  });
  // --> New supplier
  $("#saveNewSupplier_Btn").click(function (e) { 
    e.preventDefault();
    $("#cod_supplier_Fld").removeAttr("disabled")
    let f=checkForm("supplier_FRM")
     if (f==true){
      let c=confirm("Inserire il fornitore? L'operazione non è annullabile")
        if(c==true){
          $.ajax({
              type: "POST",
              url: "/supplier/newSupplier",
              data: $("#supplier_FRM").serialize(),   
              success: async function (response) {
                window.location="/supplier"
              }
            });
          }
        }
    });
    // Show/mod Raw material
  $(document).on("click",".showSupplier", async function(e){
      $("#saveSupplier_Btn").hide()

      let id=$(this).attr("idSupplier")
      idSupplier=id
      let supplierName=$(this).attr("supplierName")
      await $.ajax({
        type: "GET",
        url: "/supplier/getOneSupplier?id="+id,
        success: async function (response) {
          let data=response.supplier
          // Populate GUI
          for (const [key, value] of Object.entries(data)) {
              if($("#"+key+"_Fld").attr("tp")=="textField"){
                $("#"+key+"_Fld").val(value)
              }
              if($("#"+key+"_Fld").attr("tp")=="selectField"){
                $("#"+key+"_Fld").val(value).change();
              }
                $("#"+key+"_Show").html(value?value:"-")
            }
            $("#id_Fld").val(data.id)
          if (response.supplier.used>0){
              $("#saveSupplier_Btn").hide()
              await drawTableSupplier()
              $("#rowSupplier").show()
              $("#addElement_Btn").prop("disabled","true")
              $(".delElement_Btn").prop("disabled","true")
            } else {
              $("#rowSupplier").hide()
              $("#addElement_Btn").removeAttr("disabled")
              $(".delElement_Btn").removeAttr("disabled")
            }
          $("#showSupplier_Crd").show()
          $("#tableSupplier_Crd").hide()
          $("#newSupplier_Btn").hide()
          $("#saveNewSupplier_Btn").hide()
          $("#saveModSupplier_Btn").hide()
          $("#modSupplier_Btn").show()
          $("#backToMain_Btn").show()
          $(".supplierForm").hide()
          $(".supplierText").show()
        }
      });   
      await elementBySupplier()
    })
    // Mod supplier
    $("#modSupplier_Btn").click(function (e) { 
      e.preventDefault();
      $(".supplierForm").show()
      $(".supplierText").hide()

      $("#saveModSupplier_Btn").show()
    }); 
    // --> Mod supplier
   $("#saveModSupplier_Btn").click(function (e) { 
    e.preventDefault();
    let f=checkForm("supplier_FRM")
     if (f==true){
      let c=confirm("Modificare il fornitore?")
        if(c==true){
            $.ajax({
              type: "PUT",
              url: "/supplier/updateSupplier",
              data: $("#supplier_FRM").serialize(),   
              success: async function (response) {
                await drawTable()
                $("#showSupplier_Crd").hide()
                $("#tableSupplier_Crd").show()
                $("#newSupplier_Btn").show()
                $("#modSupplier_Btn").hide()
                $("#backToMain_Btn").hide()
                $("#saveNewSupplier_Btn").hide()
                $("#saveModSupplier_Btn").hide()
                $("#saveSupplier_Btn").show()
                $(".supplierForm").hide()
                $(".supplierText").show()
                $('#supplier_FRM')[0].reset();          
              }
            });
        }
      }
    });
   

    // Delete supplier
    $(document).on("click",".deleteSupplier_Btn", async function(e){
      e.preventDefault();
      let id=$(this).attr("idSupplier")
      let c=confirm(`Stai eliminando una fornitore, vuoi continuare? `)
      if (c==true){
        $.ajax({
        type: "DELETE",
        url: "/supplier/deleteSupplier?id="+id,
        success: async function (response) {
          await drawTable()
        }
      });
      }
    })

      // Back to main
      $("#backToMain_Btn").click(async function (e) { 
        e.preventDefault();
        await drawTable()
        $("#newSupplier_Btn").show()
        $("#backToMain_Btn").hide()
        $("#newSupplier_Crd").hide()
        $("#showSupplier_Crd").hide()
        $("#tableSupplier_Crd").show()
        $("#modSupplier_Btn").hide()
        $("#saveNewSupplier_Btn").hide()
        $("#saveModSupplier_Btn").hide()
      });  
  
  });
    

</script>
